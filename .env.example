# UniHack Product Enrichment Pipeline Environment Variables

# Backend Service
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_CORS_ORIGINS=*

# Supabase (Postgres & Correction Memory)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Gemini AI / LLM APIs (Optional for Neural / Multimodal Tiers)
GEMINI_API_KEY=your-gemini-api-key

# Scraper & Headless Fallbacks (Optional)
PLAYWRIGHT_HEADLESS=true
