# ============================================================
# ThreatCast-AI Backend
# ============================================================

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8501

# ============================================================
# Neo4j
#
# Local Docker demo:
#   neo4j://neo4j:7687
#
# Local Neo4j Desktop:
#   bolt://localhost:7687
#
# Never commit a real password.
# ============================================================

NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=threatcast_demo_password
NEO4J_DATABASE=neo4j