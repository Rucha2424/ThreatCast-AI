PORT=5000
MONGO_URI=mongodb://localhost:27017/digital-wardrobe
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Background Removal API (remove.bg / Photoroom)
REMOVE_BG_API_KEY=your-remove-bg-api-key
PHOTOROOM_API_KEY=your-photoroom-api-key

# Firebase Admin Service Account (Option 1: JSON/Base64 string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firebase Admin Service Account (Option 2: Individual variables)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
